# Copy to .env.local at the repo root (gitignored). Never commit .env.local.
#
#   cp .env.example .env.local
#
# Used by: apps/web (Next.js), wrangler preview (.dev.vars).

# --- Ledger (ingest HTTP API) ---
LEDGER_URL=http://localhost:8787
LEDGER_WRITE_SECRET=

# --- Web app (local dev + Cloudflare OAuth on /connect) ---
# Production: https://webuildreal.dev — local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Optional — defaults to dns.read dns.write
# CLOUDFLARE_OAUTH_SCOPES=dns.read dns.write
# HMAC for OAuth state
# CONNECT_STATE_SECRET=

# --- Ingest / PactRoots (workers/ingest wrangler secrets in prod) ---
# CHAIN_RPC_URL=https://sepolia.base.org
# PUBLISHER_PRIVATE_KEY=
