# Copy to .env.local at the repo root (gitignored). Never commit .env.local.
#
#   cp .env.example .env.local
#
# Used by: apps/web (Next.js), local scripts, wrangler preview (.dev.vars).

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app (local dev + Cloudflare OAuth /connect) ---
# Production: https://pact.pbm-labs.com — local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_SITE_URL=https://pbm-labs.com
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Optional — defaults to dns.read dns.write
# CLOUDFLARE_OAUTH_SCOPES=dns.read dns.write
# Optional — HMAC for OAuth state; falls back to SUPABASE_SERVICE_ROLE_KEY
# CONNECT_STATE_SECRET=

# --- Cloudflare DNS sync scripts (scripts/sync-cloudflare-dns*.py) ---
# Token: Zone DNS Edit (+ Email Routing Edit for pbm-labs.com)
CLOUDFLARE_API_TOKEN=

# Proton domain verification TXT (Proton → Domain names → Verify tab)
# PROTON_VERIFICATION=protonmail-verification=...

# DNS sync — company site on apex (scripts/sync-cloudflare-dns.py)
# COMPANY_SITE_CNAME=cname.vercel-dns.com
# VERCEL_DOMAIN_VERIFY=vc-domain-verify=pbm-labs.com,...
# CLOUDFLARE_OAUTH_PUBLISHER=cloudflare_oauth_client_publisher=...

# --- Phase 0b (not used yet) ---
# BASE_RPC_URL=
# PACT_PUBLISHER_PRIVATE_KEY=
