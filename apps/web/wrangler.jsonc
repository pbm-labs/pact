{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact-web",
  "account_id": "9deab2b981096c5b012feb4a52546fe6",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pact-web"
    }
  ],
  "routes": [
    {
      "pattern": "pact.pbm-labs.com/*",
      "zone_id": "eda4b298d663534da9d8868b7b60c084"
    }
  ],
  // Non-secret runtime config only. Set secrets via wrangler (see README):
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  //   CLOUDFLARE_OAUTH_CLIENT_ID, CLOUDFLARE_OAUTH_CLIENT_SECRET
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://pact.pbm-labs.com"
  }
}
