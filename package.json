{
  "name": "pact",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @pact/core test",
    "dev:web": "pnpm --filter @pact/web dev",
    "deploy:web": "pnpm --filter @pact/core build && env -u CLOUDFLARE_API_TOKEN pnpm --filter @pact/web deploy:cf",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@pact/core": "workspace:*",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0"
}
